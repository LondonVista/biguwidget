{
  "name": "biguwidget",
  "productName": "BigUwidget",
  "version": "1.1.1",
  "description": "Floating desktop quota dashboard for Grok, Cursor, Antigravity, and ChatGPT",
  "main": "src/main.js",
  "author": {
    "name": "london_vista",
    "url": "https://ko-fi.com/london_vista"
  },
  "license": "MIT",
  "homepage": "https://ko-fi.com/london_vista",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "com.lodonvista.biguwidget",
    "productName": "BigUwidget",
    "copyright": "Copyright © 2026 london_vista",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "synopsis": "Floating quota dashboard for Grok, Cursor, Antigravity, and ChatGPT",
      "desktop": {
        "Name": "BigUwidget",
        "Comment": "Always-on-top AI quota dashboard",
        "Categories": "Utility;"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BigUwidget"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "25.1.8"
  }
}
